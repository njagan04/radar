# Copy to .env and fill in real values. Never commit the real .env.

# --- Azure OpenAI / Azure AI Foundry (required) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=your-gpt-4o-deployment-name
AZURE_OPENAI_MODEL=gpt-4o

# --- Database / Redis ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/nexus
REDIS_URL=redis://localhost:6379

# --- Concurrency ---
MAX_CONCURRENT_INVESTIGATIONS=10
CONCURRENCY_LEASE_SECONDS=1200
CONCURRENCY_MAX_WAIT_SECONDS=120

# --- Rerun ---
RERUN_FRESHNESS_WINDOW_SECONDS=7200
RERUN_OUTCOME_CHECK_INTERVAL_SECONDS=300
RERUN_OUTCOME_MAX_CHECKS=3

# --- Base URL (used to build the chat deep-link in notifications) ---
NEXUS_BASE_URL=http://localhost:8000

# --- Temporary dev/test shortcut (2026-07-24) — used as the client_secret fallback for any
#     project whose project_factories row has no key_vault_uri set yet, instead of a real Key
#     Vault fetch, so the workflow can be tested end to end before Key Vault wiring is tested.
#     Remove once that's done. ---
ADF_CLIENT_SECRET=

# --- Outlook email delivery via Microsoft Graph (optional — degrades to a skipped-send
#     warning if left empty; not a security gate, so this is safe to leave blank in dev).
#     Use a NEW, dedicated app registration for this (Nexus's own SSO/email identity) —
#     do not reuse an existing ADF automation service principal's credentials here; different
#     permission system (Microsoft Graph vs Azure RBAC) and mixing blast radii is a bad idea. ---
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
NOTIFICATION_SENDER_UPN=

# --- HMAC signing secret for WatchTower's POST /events/pipeline-failure (required, no
#     default — the app refuses to start without a real, non-empty value here) ---
HMAC_SECRET=

# --- Denial escalation ---
DENIAL_THRESHOLD=3

# --- Batch detection (code kept, currently unused — switched off in intake/listener.py) ---
BATCH_WINDOW_SECONDS=300
BATCH_THRESHOLD=20
