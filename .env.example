# Copy to .env and fill in real values. Never commit the real .env.

# --- Azure OpenAI / Azure AI Foundry (required) ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT=your-gpt-4o-deployment-name
AZURE_OPENAI_MODEL=gpt-4o

# --- Database / Redis ---
# Lives inside WatchTower's own Postgres instance, "radar" schema — see prisma/schema.prisma
# in THIS repo (moved here from watch-Tower 2026-08-04 — this repo now owns its own schema's
# migration history directly, since it's deployed separately; this repo's own Alembic
# migrations are retired). search_path is set in code (main.py's connect_args).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/watchtower
RADAR_DB_SCHEMA=radar
# Same physical database as DATABASE_URL above, plain (non-asyncpg) connection string —
# Prisma's own format, used only by `npx prisma migrate deploy` against prisma/schema.prisma.
RADAR_SCHEMA_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/watchtower?schema=radar
REDIS_URL=redis://localhost:6379

# Connection pool sizing — per PROCESS, not per replica: with N replicas x M worker processes
# each, the real total against Postgres is N * M * (DB_POOL_SIZE + DB_MAX_OVERFLOW). This
# database is shared with WatchTower's own backend — size against Postgres's own
# max_connections and whatever WatchTower already holds, not in isolation.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT_SECONDS=5

# --- Concurrency ---
MAX_CONCURRENT_INVESTIGATIONS=10
CONCURRENCY_LEASE_SECONDS=1200
CONCURRENCY_MAX_WAIT_SECONDS=120

# --- Base URL (used to build the chat deep-link in notifications) ---
RADAR_BASE_URL=http://localhost:8000

# --- client_secret source for every ADF project: reads WatchTower's own
#     public."Credential".clientSecret (the Integrations feature's stored secret), decrypted
#     with this same passphrase — must match WatchTower's own JWT_SECRET_KEY .env value
#     exactly. Azure Key Vault is not used for this. ---
WATCHTOWER_CREDENTIAL_KEY=

# --- Set to "production" in real deployments to disable /docs, /redoc, and /openapi.json.
#     Anything else (including unset) leaves them on for local/dev use. ---
ENVIRONMENT=development

# --- HMAC signing secret for WatchTower's POST /events/pipeline-failure (required, no
#     default — the app refuses to start without a real, non-empty value here) ---
HMAC_SECRET=

# --- WatchTower/RADAR integration: must match WatchTower's own RADAR_ASSERTION_SECRET value.
#     Verifies the X-Radar-Assertion header on every chat call (chat/deps.py). Required, no
#     default (same fail-closed reasoning as HMAC_SECRET above). Notification email delivery
#     lives in WatchTower now — there is no Graph/email config here anymore. ---
RADAR_ASSERTION_SECRET=

# --- Denial escalation ---
DENIAL_THRESHOLD=3

# --- Batch detection (code kept, currently unused — switched off in intake/listener.py) ---
BATCH_WINDOW_SECONDS=300
BATCH_THRESHOLD=20
